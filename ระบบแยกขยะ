interface GameProps {
  wasteData: WasteItem[];
  onCompleteGame: (score: number) => void;
}

function GameView({ wasteData, onCompleteGame }: GameProps) {
  const [isPlaying, setIsPlaying] = useState(false);
  const [score, setScore] = useState(0);
  const [streak, setStreak] = useState(0);
  const [currentIndex, setCurrentIndex] = useState(0);
  const [shuffledItems, setShuffledItems] = useState<WasteItem[]>([]);
  const [feedback, setFeedback] = useState<'correct' | 'wrong' | null>(null);
  const [gameOver, setGameOver] = useState(false);

  const startGame = () => {
    const randomized = [...wasteData].sort(() => 0.5 - Math.random()).slice(0, 10);
    setShuffledItems(randomized);
    setCurrentIndex(0);
    setScore(0);
    setStreak(0);
    setGameOver(false);
    setIsPlaying(true);
    setFeedback(null);
  };

  const handleChooseBin = (targetCategory: string) => {
    if (!isPlaying || gameOver || feedback !== null) return;

    const currentItem = shuffledItems[currentIndex];
    const isCorrect = currentItem.category === targetCategory;

    if (isCorrect) {
      setFeedback('correct');
      const newScore = score + 10 + (streak * 2);
      setScore(newScore);
      setStreak(streak + 1);
    } else {
      setFeedback('wrong');
      setStreak(0);
    }

    setTimeout(() => {
      setFeedback(null);
      if (currentIndex + 1 < shuffledItems.length) {
        setCurrentIndex(currentIndex + 1);
      } else {
        setGameOver(true);
        setIsPlaying(false);
        onCompleteGame(score + (isCorrect ? 10 : 0));
      }
    }, 1000);
  };

  const currentItem = shuffledItems[currentIndex];

  return (
    <div className="max-w-3xl mx-auto space-y-8 animate-fadeIn">
      {/* Game Header Banner */}
      <div className="bg-gradient-to-br from-emerald-700 to-teal-800 text-white p-8 rounded-3xl shadow-xl text-center space-y-3 relative overflow-hidden">
        <div className="absolute right-[-30px] bottom-[-30px] opacity-10 text-9xl">
          🎮
        </div>
        <span className="bg-emerald-500/40 text-emerald-100 text-xs font-semibold px-3.5 py-1.5 rounded-full uppercase tracking-wider border border-emerald-400/30">
          มินิเกมฝึกทักษะรักษ์โลก
        </span>
        <h2 className="text-3xl font-black">ท้าทายความเร็ว: แยกขยะให้ถูกถัง!</h2>
        <p className="text-emerald-100 text-sm max-w-lg mx-auto">
          ทดสอบความรู้ของคุณโดยการเลือกทิ้งขยะที่ปรากฏลงในถังขยะ 4 สีให้ถูกต้องภายใน 10 ข้อ
        </p>

        {!isPlaying && !gameOver && (
          <button
            onClick={startGame}
            className="mt-4 px-8 py-4 bg-yellow-400 hover:bg-yellow-300 text-slate-900 font-black rounded-2xl shadow-xl transition-all hover:scale-105 active:scale-95 inline-flex items-center space-x-2"
          >
            <Flame className="w-5 h-5 text-rose-600" />
            <span>เริ่มเล่นเกมเลย!</span>
          </button>
        )}
      </div>

      {/* Game Arena */}
      {isPlaying && currentItem && (
        <div className="bg-white p-8 rounded-3xl border border-slate-200 shadow-xl space-y-8">
          {/* Status Bar */}
          <div className="flex justify-between items-center text-sm font-bold text-slate-600 border-b border-slate-100 pb-4">
            <span className="flex items-center gap-1.5">
              ข้อที่ <strong className="text-emerald-600 text-lg">{currentIndex + 1}</strong> / {shuffledItems.length}
            </span>
            <div className="flex items-center space-x-6">
              <span>คะแนน: <strong className="text-emerald-600 text-lg">{score}</strong></span>
              <span>คอมโบ: <strong className="text-amber-600 text-lg">🔥 {streak}x</strong></span>
            </div>
          </div>

          {/* Item Card */}
          <div className={`p-8 rounded-3xl text-center transition-all duration-300 relative overflow-hidden ${
            feedback === 'correct' ? 'bg-emerald-100 border-2 border-emerald-500 scale-102' :
            feedback === 'wrong' ? 'bg-rose-100 border-2 border-rose-500 animate-shake' :
            'bg-slate-50 border border-slate-200'
          }`}>
            <div className="text-6xl mb-3">{currentItem.icon}</div>
            <h3 className="text-2xl font-black text-slate-800">{currentItem.name}</h3>
            <p className="text-xs text-slate-500 mt-1">นี่คือขยะประเภทใด? เลือกถังด้านล่างให้ถูกต้อง</p>

            {feedback === 'correct' && (
              <div className="absolute inset-0 bg-emerald-600/90 text-white flex flex-col items-center justify-center animate-fadeIn">
                <CheckCircle2 className="w-16 h-16 text-yellow-300 mb-2" />
                <h4 className="text-2xl font-black">ถูกต้องนะคร้าบ! 🎉</h4>
              </div>
            )}
            {feedback === 'wrong' && (
              <div className="absolute inset-0 bg-rose-600/90 text-white flex flex-col items-center justify-center animate-fadeIn">
                <XCircle className="w-16 h-16 text-yellow-300 mb-2" />
                <h4 className="text-2xl font-black">เกือบถูกแล้ว! ถังที่ถูกต้องคือ: {currentItem.binName}</h4>
              </div>
            )}
          </div>

          {/* 4 Bins Options Grid */}
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {[
              { id: 'organic', name: 'ถังสีเขียว', desc: 'ขยะอินทรีย์', color: 'bg-emerald-600 hover:bg-emerald-700', icon: '🟢' },
              { id: 'recycle', name: 'ถังสีเหลือง', desc: 'ขยะรีไซเคิล', color: 'bg-amber-500 hover:bg-amber-600', icon: '🟡' },
              { id: 'hazardous', name: 'ถังสีแดง', desc: 'ขยะอันตราย', color: 'bg-rose-600 hover:bg-rose-700', icon: '🔴' },
              { id: 'general', name: 'ถังสีน้ำเงิน', desc: 'ขยะทั่วไป', color: 'bg-sky-600 hover:bg-sky-700', icon: '🔵' }
            ].map(bin => (
              <button
                key={bin.id}
                disabled={feedback !== null}
                onClick={() => handleChooseBin(bin.id)}
                className={`${bin.color} text-white p-6 rounded-2xl shadow-lg transition-all hover:scale-105 active:scale-95 flex flex-col items-center space-y-2 cursor-pointer disabled:opacity-50`}
              >
                <span className="text-3xl">{bin.icon}</span>
                <span className="font-black text-base">{bin.name}</span>
                <span className="text-xs text-white/80 font-medium">{bin.desc}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      {/* Game Over Screen */}
      {gameOver && (
        <div className="bg-white p-10 rounded-3xl border border-slate-200 shadow-xl text-center space-y-6 animate-fadeIn">
          <div className="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-4xl shadow-inner">
            🏆
          </div>
          <div className="space-y-2">
            <h3 className="text-3xl font-black text-slate-800">เกมสิ้นสุดแล้ว! ยอดเยี่ยมมาก</h3>
            <p className="text-slate-500">คุณทำคะแนนรวมได้ทั้งหมด</p>
            <div className="text-5xl font-black text-emerald-600">{score} คะแนน</div>
          </div>

          <button
            onClick={startGame}
            className="px-8 py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-2xl shadow-lg transition-all hover:scale-105 inline-flex items-center space-x-2"
          >
            <RotateCcw className="w-5 h-5" />
            <span>เล่นใหม่อีกครั้ง</span>
          </button>
        </div>
      )}

      {/* Idle Game Starter Prompt */}
      {!isPlaying && !gameOver && (
        <div className="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm text-center space-y-4">
          <h4 className="font-bold text-slate-800 text-lg">💡 เคล็ดลับการเล่นเกม</h4>
          <p className="text-sm text-slate-500 max-w-md mx-auto">
            การคัดแยกขยะในชีวิตจริงช่วยลดการใช้พลังงานและลดก๊าซเรือนกระจก มาฝึกฝนให้เกิดความคุ้นเคยกันเถอะ!
          </p>
        </div>
      )}
    </div>
  );
}

