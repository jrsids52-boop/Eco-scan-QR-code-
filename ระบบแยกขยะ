            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 max-h-[650px] overflow-y-auto pr-2">
              {filteredItems.map(item => {
                const isSelected = selectedItem?.id === item.id;
                return (
                  <div
                    key={item.id}
                    onClick={() => setSelectedItem(item)}
                    className={`bg-white p-5 rounded-2xl border transition-all cursor-pointer flex items-center space-x-4 shadow-sm hover:shadow-md ${
                      isSelected 
                        ? 'border-emerald-500 ring-2 ring-emerald-400/30 bg-emerald-50/40 translate-x-1' 
