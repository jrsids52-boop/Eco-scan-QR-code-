                    <div className="flex-1 min-w-0">
                      <div className="flex items-center space-x-2">
                        <span className={`w-3 h-3 rounded-full ${item.binHex}`} />
                        <span className="text-xs font-bold text-slate-400 uppercase tracking-wide">
                          {item.category === 'organic' && 'อินทรีย์'}
                          {item.category === 'recycle' && 'รีไซเคิล'}
                          {item.category === 'hazardous' && 'อันตราย'}
                          {item.category === 'general' && 'ทั่วไป'}
                        </span>
                      </div>
                      <h4 className="font-bold text-slate-800 text-base truncate mt-0.5">{item.name}</h4>
                      <p className="text-xs text-slate-500 truncate mt-0.5">{item.binName}</p>
                    </div>
                    <ChevronRight className={`w-5 h-5 text-slate-400 transition-transform ${isSelected ? 'rotate-90 text-emerald-600' : ''}`} />
                  </div>
                );
              })}
            </div>
          )}
        </div>

        {/* Right Detail Card (Inspector) */}
        <div className="lg:col-span-5 sticky top-24">
          {selectedItem ? (
            <div className="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden animate-fadeIn">
              {/* Header Banner colored by Bin Type */}
              <div className={`${selectedItem.binHex} p-6 text-white relative overflow-hidden`}>
                <div className="absolute right-[-20px] bottom-[-20px] opacity-20 text-8xl pointer-events-none">
                  {selectedItem.icon}
                </div>
                <div className="relative z-10 flex items-center justify-between">
                  <span className="bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
                    รายละเอียดการคัดแยก
                  </span>
                  <span className="text-3xl">{selectedItem.icon}</span>
                </div>
                <div className="mt-4 relative z-10">
                  <h3 className="text-2xl font-black">{selectedItem.name}</h3>
                  <p className="text-white/90 text-sm font-medium mt-1 flex items-center gap-1.5">
                    <CheckCircle2 className="w-4 h-4 text-emerald-200" /> แนะนำทิ้งลง: <strong className="underline">{selectedItem.binName}</strong>
                  </p>
                </div>
              </div>

              {/* Body Details */}
              <div className="p-6 space-y-6">
                {/* Simulated Bin Graphic */}
                <div className="bg-slate-50 p-4 rounded-2xl border border-slate-100 flex items-center space-x-4">
                  <div className={`w-14 h-16 ${selectedItem.binHex} rounded-t-lg rounded-b-md shadow-lg flex flex-col items-center justify-center text-white relative flex-shrink-0`}>
                    <div className="w-8 h-1.5 bg-white/40 rounded-full absolute top-1.5" />
                    <Trash2 className="w-6 h-6 mt-1" />
                  </div>
                  <div>
                    <h5 className="font-bold text-slate-800 text-sm">ถังขยะที่ถูกต้อง</h5>
                    <p className="text-xs text-slate-600 font-medium mt-0.5">{selectedItem.binName}</p>
                    <span className="text-[11px] text-emerald-600 font-semibold mt-1 block">
                      ✓ แยกถูกต้องช่วยลดปริมาณขยะฝังกลบได้มาก
                    </span>
                  </div>
                </div>

                {/* Instructions */}
                <div className="space-y-2">
                  <h5 className="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
                    <Info className="w-4 h-4 text-emerald-600" /> วิธีการจัดการก่อนทิ้ง
                  </h5>
                  <div className="bg-emerald-50/60 border border-emerald-100 p-4 rounded-2xl text-slate-700 text-sm font-medium leading-relaxed">
                    {selectedItem.instructions}
                  </div>
                </div>

                {/* Decomposition Time */}
                <div className="flex items-center justify-between bg-slate-50 p-4 rounded-2xl border border-slate-100">
