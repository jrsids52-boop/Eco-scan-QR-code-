            </div>
          </div>
          <div className="mt-4">
            <h3 className="text-3xl font-black text-amber-600">{stats.recycleCount}</h3>
            <p className="text-xs text-slate-500 mt-1">ชิ้น (นำกลับมาใช้ใหม่)</p>
          </div>
        </div>

        <div className="bg-white p-6 rounded-3xl border border-rose-100 shadow-sm flex flex-col justify-between">
          <div className="flex justify-between items-start">
            <span className="text-xs font-bold uppercase tracking-wider text-rose-600">ถังขยะอันตราย</span>
            <div className="w-10 h-10 rounded-2xl bg-rose-100 text-rose-700 flex items-center justify-center font-bold">
              🔴
            </div>
          </div>
          <div className="mt-4">
            <h3 className="text-3xl font-black text-rose-600">{stats.hazardousCount}</h3>
            <p className="text-xs text-slate-500 mt-1">ชิ้น (ต้องกำจัดพิเศษ)</p>
