            <div style={{ width: `${(stats.hazardousCount / stats.total) * 100}%` }} className="bg-rose-500 transition-all duration-500" title="อันตราย" />
            <div style={{ width: `${(stats.generalCount / stats.total) * 100}%` }} className="bg-sky-500 transition-all duration-500" title="ทั่วไป" />
          </div>
          <div className="flex flex-wrap gap-4 text-xs font-semibold text-slate-600 pt-2">
