                    <div className="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center">
                      <Clock className="w-5 h-5" />
                    </div>
                    <div>
                      <h6 className="text-xs font-bold text-slate-400 uppercase">ระยะเวลาย่อยสลาย</h6>
                      <p className="text-sm font-bold text-slate-800">{selectedItem.decompositionTime}</p>
                    </div>
                  </div>
                </div>

                {/* Action Button: Log to History */}
                <button
                  onClick={() => onLogItem(selectedItem)}
                  className="w-full py-4 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-bold shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center space-x-2 active:scale-95"
                >
                  <Sparkles className="w-5 h-5 text-yellow-300" />
                  <span>บันทึกการทิ้งขยะชิ้นนี้ลงในประวัติ</span>
                </button>
              </div>
            </div>
          ) : (
            <div className="bg-white rounded-3xl p-8 text-center border border-slate-200 shadow-sm">
              <p className="text-slate-500">กรุณาเลือกรายการขยะทางซ้ายเพื่อดูรายละเอียด</p>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

interface HistoryProps {
  history: HistoryItem[];
  onClearHistory: () => void;
  onDeleteItem: (id: string) => void;
}

function HistoryView({ history, onClearHistory, onDeleteItem }: HistoryProps) {
  const stats = useMemo(() => {
    const total = history.reduce((acc, curr) => acc + curr.count, 0);
    const organicCount = history.filter(h => h.category === 'organic').reduce((acc, curr) => acc + curr.count, 0);
    const recycleCount = history.filter(h => h.category === 'recycle').reduce((acc, curr) => acc + curr.count, 0);
    const hazardousCount = history.filter(h => h.category === 'hazardous').reduce((acc, curr) => acc + curr.count, 0);
    const generalCount = history.filter(h => h.category === 'general').reduce((acc, curr) => acc + curr.count, 0);
    return { total, organicCount, recycleCount, hazardousCount, generalCount };
  }, [history]);

  return (
    <div className="space-y-8 animate-fadeIn">
      {/* Top Banner */}
      <div className="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
        <div>
          <h2 className="text-2xl font-black text-slate-800">ประวัติและสถิติการคัดแยกขยะ</h2>
          <p className="text-slate-500 text-sm mt-1">
            ข้อมูลทั้งหมดถูกบันทึกไว้อย่างปลอดภัยใน LocalStorage ของเบราว์เซอร์คุณ
          </p>
        </div>
        {history.length > 0 && (
          <button
            onClick={onClearHistory}
            className="px-4 py-2.5 bg-rose-50 text-rose-600 hover:bg-rose-100 rounded-xl text-sm font-semibold transition-colors flex items-center space-x-2 border border-rose-200 shadow-sm"
          >
            <Trash className="w-4 h-4" />
            <span>ล้างประวัติทั้งหมด</span>
          </button>
        )}
      </div>

      {/* Stats Summary Cards */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div className="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div className="flex justify-between items-start">
            <span className="text-xs font-bold uppercase tracking-wider text-slate-400">ขยะทั้งหมด</span>
            <div className="w-10 h-10 rounded-2xl bg-slate-100 text-slate-700 flex items-center justify-center font-bold">
              📊
            </div>
          </div>
          <div className="mt-4">
            <h3 className="text-3xl font-black text-slate-800">{stats.total}</h3>
            <p className="text-xs text-slate-500 mt-1">ชิ้นที่คัดแยกแล้ว</p>
          </div>
        </div>

        <div className="bg-white p-6 rounded-3xl border border-emerald-100 shadow-sm flex flex-col justify-between">
          <div className="flex justify-between items-start">
            <span className="text-xs font-bold uppercase tracking-wider text-emerald-600">ถังขยะอินทรีย์</span>
            <div className="w-10 h-10 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
              🟢
            </div>
          </div>
          <div className="mt-4">
            <h3 className="text-3xl font-black text-emerald-700">{stats.organicCount}</h3>
            <p className="text-xs text-slate-500 mt-1">ชิ้น (ย่อยสลายได้)</p>
          </div>
        </div>

        <div className="bg-white p-6 rounded-3xl border border-amber-100 shadow-sm flex flex-col justify-between">
          <div className="flex justify-between items-start">
            <span className="text-xs font-bold uppercase tracking-wider text-amber-600">ถังขยะรีไซเคิล</span>
